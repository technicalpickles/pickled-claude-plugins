{
  "description": "Nudge taskwarrior UUID-safety when a skill that writes durable, resumed-later artifacts is invoked; auto-resolve the UUID of a task just created with `task add`",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/nudge-uuid-on-handoff.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/resolve-added-task-uuid.py"
          }
        ]
      }
    ]
  }
}
