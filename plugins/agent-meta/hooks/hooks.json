{
  "description": "Inject the park destination command into context when agent-meta:park is invoked",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject-session-context.py"
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
