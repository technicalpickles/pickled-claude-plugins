{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-hk-instructions.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hk-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
